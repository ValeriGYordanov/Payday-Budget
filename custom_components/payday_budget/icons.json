{
  "entity": {
    "sensor": {
      "period": { "default": "mdi:calendar-range" },
      "period_start": { "default": "mdi:calendar-start" },
      "income": { "default": "mdi:cash-plus" },
      "expenses": { "default": "mdi:cash-minus" },
      "balance": { "default": "mdi:scale-balance" },
      "unallocated": { "default": "mdi:wallet-outline" },
      "history": { "default": "mdi:chart-bar" },
      "budget_target": { "default": "mdi:target" },
      "budget_spent": { "default": "mdi:cart-outline" },
      "budget_remaining": { "default": "mdi:wallet" },
      "budget_used": { "default": "mdi:percent" },
      "recent_transactions": { "default": "mdi:format-list-bulleted" },
      "categories": { "default": "mdi:shape-outline" },
      "budgets": { "default": "mdi:wallet-outline" },
      "reminders": { "default": "mdi:bell-outline" },
      "projected_balance": { "default": "mdi:chart-timeline-variant" },
      "safe_per_day": { "default": "mdi:cash-clock" },
      "expected_payday": { "default": "mdi:calendar-arrow-right" },
      "upcoming": { "default": "mdi:calendar-clock" },
      "budget_projected": { "default": "mdi:chart-line" }
    },
    "binary_sensor": {
      "budget_over_target": { "default": "mdi:check-circle-outline", "state": { "on": "mdi:alert-circle" } },
      "budget_on_track": { "default": "mdi:alert-outline", "state": { "on": "mdi:check-circle" } }
    },
    "button": {
      "start_new_period": { "default": "mdi:calendar-plus" }
    }
  },
  "services": {
    "add_transaction": { "service": "mdi:cash-register" },
    "update_transaction": { "service": "mdi:pencil" },
    "delete_transaction": { "service": "mdi:delete" },
    "start_period": { "service": "mdi:calendar-plus" },
    "get_summary": { "service": "mdi:chart-box" },
    "list_transactions": { "service": "mdi:format-list-bulleted" },
    "add_category": { "service": "mdi:shape-plus" },
    "update_category": { "service": "mdi:shape-outline" },
    "delete_category": { "service": "mdi:delete" },
    "record_reminder": { "service": "mdi:bell-check" },
    "dismiss_reminder": { "service": "mdi:bell-off" },
    "get_forecast": { "service": "mdi:chart-timeline-variant" }
  }
}
